# OPTIONAL. The app boots without this file and the Setup pane writes the key
# for you (Setup -> API key). Copy this to .env only if you'd rather set it by
# hand. .env is gitignored — never commit it.
#
# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# A real environment variable takes priority over this file, and over anything
# the Setup pane writes here. That's what the cloud deploy uses.

# Google OAuth is NOT configured here. It uses two files in the project root:
#   credentials.json — downloaded from Google Cloud Console (you create this)
#   token.json       — written automatically on first successful auth
# Both are gitignored.
